{
  "name": "whalemind-debate-united-platform",
  "private": true,
  "version": "0.1.0",
  "description": "辩论赛全流程系统：主席控制台 + 评委打分端 + 大屏展示端",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @debate/server dev",
    "dev:client": "pnpm --filter @debate/client dev",
    "test": "pnpm --filter @debate/server test",
    "typecheck": "pnpm -r typecheck",
    "build:client": "pnpm --filter @debate/client build",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm build:client && pnpm build:server",
    "release": "pnpm build && node scripts/package-release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1"
  }
}
